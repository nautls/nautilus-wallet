{
  "name": "nautilus-wallet",
  "version": "1.3.6",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:mainnet": "vite",
    "dev:testnet": "NETWORK=testnet vite",
    "dev:docs": "vitepress dev docs",
    "build:mainnet:chrome": "vite build",
    "build:mainnet:firefox": "TARGET=firefox vite build",
    "build:testnet:chrome": "NETWORK=testnet vite build",
    "build:testnet:firefox": "TARGET=firefox NETWORK=testnet vite build",
    "build:mainnet:chrome:stage": "vite build --mode staging",
    "build:inspect": "INSPECT=true vite build",
    "build:docs": "vitepress build docs",
    "test:unit": "vitest run",
    "test:e2e": "vite build && playwright test",
    "test:e2e:ui": "vite build && playwright test --ui",
    "test:lint": "TIMING=1 eslint ./src",
    "test:format": "prettier ./src ./tests --check",
    "fix:format": "prettier ./src ./tests --write",
    "test:types": "vue-tsc --build --force"
  },
